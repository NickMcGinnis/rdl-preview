{
  "name": "rdl-preview",
  "displayName": "RDL Preview",
  "description": "Preview, edit and design local SSRS RDL reports: server-rendered previews with parameters and saved environments, RDL language support, and a properties designer.",
  "version": "0.1.3",
  "publisher": "NickMcGinnis",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "SSRS",
    "RDL",
    "reports",
    "preview",
    "Power BI Report Server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NickMcGinnis/rdl-preview.git"
  },
  "homepage": "https://github.com/NickMcGinnis/rdl-preview#readme",
  "bugs": {
    "url": "https://github.com/NickMcGinnis/rdl-preview/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.rdl"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing, the designer and language features work in any workspace. Previewing and server validation send the report to a server, so they need a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "rdl",
        "aliases": [
          "RDL",
          "rdl"
        ],
        "extensions": [
          ".rdl",
          ".rdlc"
        ],
        "configuration": "./language/rdl.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rdl",
        "scopeName": "text.xml.rdl",
        "path": "./language/rdl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rdl",
        "path": "./language/rdl.snippets.json"
      }
    ],
    "xmlLanguageParticipants": [
      {
        "languageId": "rdl"
      }
    ],
    "customEditors": [
      {
        "viewType": "rdlPreview.designer",
        "displayName": "RDL Designer",
        "selector": [
          {
            "filenamePattern": "*.rdl"
          },
          {
            "filenamePattern": "*.rdlc"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "rdlPreview.preview",
        "title": "Preview Report",
        "category": "RDL Preview",
        "icon": "$(graph)"
      },
      {
        "command": "rdlPreview.manageProfiles",
        "title": "Manage Connections",
        "category": "RDL Preview"
      },
      {
        "command": "rdlPreview.switchProfile",
        "title": "Switch Environment",
        "category": "RDL Preview"
      },
      {
        "command": "rdlPreview.testConnection",
        "title": "Test Connection",
        "category": "RDL Preview"
      },
      {
        "command": "rdlPreview.demo",
        "title": "Open Demo Report",
        "category": "RDL Preview"
      },
      {
        "command": "rdlPreview.openDesigner",
        "title": "Open Designer",
        "category": "RDL Preview",
        "icon": "$(layout)"
      },
      {
        "command": "rdlPreview.openXml",
        "title": "Open XML",
        "category": "RDL Preview",
        "icon": "$(code)"
      },
      {
        "command": "rdlPreview.validate",
        "title": "Validate on Server",
        "category": "RDL Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rdlPreview.openDesigner",
          "when": "resourceLangId == rdl && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation@1"
        },
        {
          "command": "rdlPreview.openXml",
          "when": "activeCustomEditorId == rdlPreview.designer",
          "group": "navigation@1"
        },
        {
          "command": "rdlPreview.preview",
          "when": "resourceExtname == .rdl",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "rdlPreview.preview",
          "when": "resourceExtname == .rdl",
          "group": "navigation"
        },
        {
          "command": "rdlPreview.openDesigner",
          "when": "resourceExtname =~ /^\\.rdlc?$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "rdlPreview.openDesigner",
          "when": "resourceLangId == rdl || activeCustomEditorId == rdlPreview.designer"
        },
        {
          "command": "rdlPreview.openXml",
          "when": "activeCustomEditorId == rdlPreview.designer"
        },
        {
          "command": "rdlPreview.validate",
          "when": "resourceExtname == .rdl"
        }
      ]
    },
    "configuration": {
      "title": "RDL Preview",
      "properties": {
        "rdlPreview.profiles": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "markdownDescription": "Saved connections on this machine. Use **RDL Preview: Manage Connections** to edit. Passwords belong in SecretStorage, never here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "serverUrl",
              "auth"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "serverUrl": {
                "type": "string",
                "description": "Report server URL, typically https://host/reportserver (not /reports)."
              },
              "auth": {
                "type": "string",
                "enum": [
                  "windows",
                  "ntlm",
                  "basic",
                  "demo"
                ]
              },
              "username": {
                "type": "string"
              },
              "catalogFolder": {
                "type": "string",
                "default": "/",
                "description": "Catalog folder used to resolve relative shared report resources."
              },
              "parameterLanguage": {
                "type": "string",
                "default": "en-US"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 600,
                "default": 120
              },
              "allowHttp": {
                "type": "boolean",
                "default": false,
                "description": "Explicitly permit unencrypted HTTP for this connection, including Basic authentication. Basic credentials and report data travel without encryption."
              },
              "dataSources": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reference": {
                      "type": "string"
                    },
                    "connectionString": {
                      "type": "string"
                    },
                    "dataProvider": {
                      "type": "string"
                    }
                  }
                },
                "description": "Overrides keyed by RDL DataSource Name. Use reference OR a connectionString without credentials. Applied only to the submitted preview copy."
              }
            }
          }
        },
        "rdlPreview.refreshOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Re-run the open preview with the same parameter values each time its report is saved. Every refresh starts a new execution on the report server."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:extension": "node scripts/test-extension.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
